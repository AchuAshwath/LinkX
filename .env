PROJECT_NAME="LinkX"
STACK_NAME="linkx"

# Base domain used by Docker Compose / Traefik
DOMAIN=localhost.tiangolo.com

# Environment
ENVIRONMENT=local

# Frontend & CORS configuration
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# Security / Auth
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Email (Mailcatcher for local dev, or leave empty)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com

# Sentry (optional)
SENTRY_DSN=

# Redis (used for OAuth / LinkedIn tokens)
REDIS_URL=redis://redis:6379/0

# LinkedIn OAuth (fill with your developer credentials in .env.local)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social

# Docker images for backend/frontend (used by docker-compose)
DOCKER_IMAGE_BACKEND=linkx-backend
DOCKER_IMAGE_FRONTEND=linkx-frontend

# AI Proxy / Router Key (CLIProxyAPI)
# Put your active key in .env.local (e.g. OPENAI_API_COMPATIBLE_API_KEY=your_key)
OPENAI_API_COMPATIBLE_API_KEY=
